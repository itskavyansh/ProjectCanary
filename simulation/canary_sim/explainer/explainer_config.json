{
  "model_default": "muse-spark-1.3",
  "api_endpoint": "https://api.meta.ai/v1/chat/completions",
  "timeout_s": 45.0,
  "max_http_retries": 1,
  "budget": {
    "default_cap_usd": 5.0,
    "cost_per_m_input_usd": 1.25,
    "cost_per_m_cached_input_usd": 0.15,
    "cost_per_m_output_usd": 4.25,
    "max_calls": 600,
    "max_total_tokens": 2000000
  },
  "guard": {
    "min_sentences_summary": 2,
    "max_sentences_summary": 3,
    "max_sentences_suggested_check": 1,
    "min_total_chars": 40,
    "max_total_chars": 750,
    "required_simulation_words": [
      "simulated",
      "synthetic"
    ],
    "forbidden_claim_regexes": [
      "\\bevacuat(e|ion|ing)\\b",
      "\\bcollapse\\s+imminent\\b",
      "\\bimminent\\s+collapse\\b",
      "\\bsafe\\b",
      "\\bunsafe\\b",
      "\\bdanger\\s+now\\b",
      "\\bimmediate\\s+danger\\b",
      "\\bthe\\s+ground\\s+is\\b",
      "\\bthe\\s+mine\\b",
      "\\breal[-\\s]+world\\b",
      "\\bactual\\s+ground\\b",
      "\\bactually\\s+(collapsing|subsiding|moving|tilting|failing)\\b",
      "\\broof\\s+fall\\b",
      "\\bpillar\\s+failure\\b",
      "\\blife[-\\s]+safety\\b",
      "\\bpersonnel\\s+must\\b",
      "\\bshut\\s+down\\s+operations\\b"
    ],
    "forbidden_score_terms": [
      "\\bprobabilit(y|ies)\\b",
      "\\bconfiden(ce|t|tly)\\b",
      "\\bcertain(ty|ly)?\\b",
      "\\bguaranteed?\\b"
    ],
    "forbidden_alarm_change_regexes": [
      "\\b(chang(e|ed|ing)|overrid(e|den|ing)|upgrad(e|ed|ing)|downgrad(e|ed|ing)|clear(ed|ing)?|suppress(ed|ing)?|cancel(led|ling)?|escalat(e|ed|ing)|rais(e|ed|ing))\\s+(the\\s+)?alarm\\b",
      "\\balarm\\s+(state\\s+)?(is\\s+|has\\s+been\\s+|should\\s+be\\s+)?(changed|overridden|upgraded|downgraded|cleared|suppressed|cancelled|escalated)\\b"
    ]
  }
}
