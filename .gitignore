# =============================================================================
# ProjectCanary  -  .gitignore
# =============================================================================

# Environment / secrets — NEVER commit real credentials
.env
.env.local
.env.*.local

# Supabase CLI local cache
supabase/.temp/

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Build outputs
dist/
dist-ssr/

# Python
__pycache__/
*.pyc
.pytest_cache/

# OS
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/
*.swp
*.suo
*.ntvs*
*.njsproj
*.sln

# Temporary test bridge artifacts
temp.json
*.log
scripts/testing/logs/